# Copy this file to .env and fill in the values before starting the server.
# Never commit the real .env file.

# Port the Express API listens on
PORT=4000

# PostgreSQL connection string (PostgreSQL 16).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Replace <password> with the password of your local 'library' database role.
DATABASE_URL=postgres://library:<password>@localhost:5432/library

# Secret used to sign JWTs. REQUIRED: the server refuses to start without it.
# Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT lifetime (jsonwebtoken expiresIn format)
JWT_EXPIRES_IN=24h

# Allowed origin for CORS (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Number of days a loan lasts before it is due
LOAN_DAYS=14