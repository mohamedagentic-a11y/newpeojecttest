# Backend environment configuration (example)
# Copy this file to .env and fill in the values before starting the server.
# Do NOT commit the real .env file.

# Port the Express API listens on
PORT=4000

# PostgreSQL connection string (required; no default).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Under docker-compose the host is the "postgres" service name.
# Supply the user and password from your own secret store.
DATABASE_URL=

# Secret used to sign JWTs (required; no default).
# Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT lifetime (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN=24h

# Number of days a borrowed book may be kept before it is due
LOAN_PERIOD_DAYS=14

# Allowed origin for browser requests from the frontend (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173